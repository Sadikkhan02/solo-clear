# MongoDB Atlas Connection String (M0 Free Tier Compatible)
# ⚠️ IMPORTANT: Include maxPoolSize=1 for serverless environments (Vercel)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/solo_clear?retryWrites=true&w=majority&maxPoolSize=1&socketTimeoutMS=30000&connectTimeoutMS=30000

# NextAuth Secret (Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
NEXTAUTH_SECRET=your-secure-32-character-secret-key

# Application URL (Local: http://localhost:3000, Production: https://your-app.vercel.app)
NEXTAUTH_URL=http://localhost:3000

# -------------------------------------------------------------
# Email Configuration (Nodemailer)
# -------------------------------------------------------------
# For Production (Vercel): Use 'sendgrid' or 'resend' (works best in serverless)
# For Development: Use 'gmail' with an App Password (or leave blank for console logging)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM="Solo Clear <noreply@soloclear.app>"
